{
  "schema_version": 2,
  "design_source_repo": "NFF98/NodeFF",
  "forbidden_top_level_directories": ["working", "spec", "execution"],
  "immutable_after_merge": ["build-spec/baselines"],
  "implementation_roots": ["src/", "tests/"],
  "hold_exceptions": ["src/README.md", "tests/README.md"],
  "governance_only_paths": [
    "build-spec/",
    "harness/",
    ".cursor/",
    ".github/",
    "AGENTS.md",
    "delivery/templates/",
    "delivery/deltas/"
  ],
  "cursor_product_implementation_requires": ["active_locked_build_spec", "active_approved_sprint", "active_task"],
  "finding_classifications": ["IMPLEMENTATION_BUG", "TEST_BUG", "SPEC_AMBIGUITY", "DESIGN_DELTA_CANDIDATE", "BUILD_BLOCKER"],
  "finding_statuses": ["OPEN", "ASSESSING", "BLOCKED", "RESOLVED", "CLOSED"],
  "delta_types": ["DESIGN_DELTA", "IMPLEMENTATION_DELTA", "TEST_DELTA", "DEBUG_FINDING", "FIX_DELTA"],
  "delta_statuses": ["OPEN", "ASSESSING", "APPROVED", "IMPLEMENTING", "VERIFIED", "CLOSED", "REJECTED"],
  "human_gate_required_for": [
    "DESIGN_DELTA",
    "BUILD_SPEC_FREEZE",
    "BUILD_SPEC_REBASELINE",
    "SPRINT_ACTIVATION",
    "SPRINT_CLOSE",
    "PRODUCT_DECISION",
    "MATERIAL_VISUAL_CHANGE",
    "PUBLIC_DATA_SECURITY_RUNTIME_CONTRACT_CHANGE"
  ],
  "max_same_strategy_failures_before_escalation": 2
}
