{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appf2 Build Spec Projection Map",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "phase",
    "source_repo",
    "source_commit",
    "freeze_audit",
    "projection_engine",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^BS-P[0-9]+-[0-9]{3}$"
    },
    "phase": {
      "type": "string",
      "pattern": "^PHASE_[0-9]+$"
    },
    "source_repo": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "freeze_audit": {
      "type": "object",
      "required": [
        "status",
        "version_lock",
        "source_commit"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "version_lock": {
          "const": true
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "projection_engine": {
      "type": "object",
      "required": [
        "version",
        "matching",
        "fuzzy_matching",
        "llm_classification"
      ],
      "properties": {
        "version": {
          "const": "MARKDOWN_EXACT_HEADING_V1"
        },
        "matching": {
          "const": "EXACT_ONLY"
        },
        "fuzzy_matching": {
          "const": false
        },
        "llm_classification": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "source_blob_sha",
          "mode",
          "phase_scope",
          "freeze_audit_verification"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_blob_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "mode": {
            "enum": [
              "FULL_COPY",
              "SECTION_FILTERED",
              "REFERENCE_ONLY"
            ]
          },
          "target_path": {
            "type": "string",
            "minLength": 1
          },
          "phase_scope": {
            "type": "string",
            "pattern": "^PHASE_[0-9]+_APPLICABLE_TRUTH_ONLY$"
          },
          "freeze_audit_verification": {
            "enum": [
              "SELF_MARKER",
              "UI_REFERENCE_INVENTORY",
              "REFERENCE_ONLY_DECLARATION"
            ]
          },
          "include_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "start",
                "end_before"
              ],
              "properties": {
                "start": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "BOF"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "const": "EXACT_HEADING"
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "end_before": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "EOF"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "const": "EXACT_HEADING"
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "exclusion_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "SECTION_FILTERED"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "target_path",
                "include_blocks",
                "output_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "FULL_COPY"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "target_path",
                "output_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "REFERENCE_ONLY"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "exclusion_reason"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
